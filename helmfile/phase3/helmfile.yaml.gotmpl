repositories:
  - name: kubearmor
    url: https://helm.kubearmor.io
  - name: fluent
    url: https://fluent.github.io/helm-charts
  - name: kafka
    url: https://charts.bitnami.com/bitnami
  # opensearch repo removed — see docs/observability.md "OpenSearch Decision Record"
  # replaced by: Apache Flink (CEP correlation) + ClickHouse (analytics store)

helmDefaults:
  wait: true
  timeout: 600
  createNamespace: true

releases:

  # ── KubeArmor ─────────────────────────────────────────────────────────────
  # Runtime security enforcement — blocks syscall violations, not just alerts.
  # SPIFFE-aware: scopes policies to SPIRE SVIDs.

  - name: kubearmor
    namespace: kubearmor-system
    chart: kubearmor/kubearmor
    values:
      - values/kubearmor.yaml

  - name: kubearmor-operator
    namespace: kubearmor-system
    chart: kubearmor/kubearmor-operator
    needs:
      - kubearmor-system/kubearmor
    values:
      - values/kubearmor-operator.yaml
    hooks:
      - events: ["postsync"]
        command: "bash"
        args: ["{{ env "REPO_ROOT" }}/helmfile/phase3/hooks/kubearmor-apply-baseline.sh"]

  # ── KubeArmor OPAL Controller ─────────────────────────────────────────────
  # Watches OPA for anomaly events. On anomaly: tightens the offending agent's
  # KubeArmor CRD policy in real time. Closes the OPAL → OPA → KubeArmor loop.

  - name: kubearmor-controller
    namespace: kubearmor-system
    chart: {{ env "REPO_ROOT" }}/charts/kubearmor-controller
    needs:
      - kubearmor-system/kubearmor-operator
    values:
      - values/kubearmor-controller.yaml

  # ── OpenSearch — REMOVED ──────────────────────────────────────────────────
  # Originally planned as SIEM for cross-source correlation.
  # Removed because:
  #   1. Flink CEP covers all correlation rules better (event-time, ordered
  #      patterns, stateful interval joins — none of which OpenSearch supports)
  #   2. ClickHouse replaces analytics at 50x the query speed
  #   3. OpenSearch added ~$82/month EC2 cost for 3 dedicated nodes
  #   4. Flink + ClickHouse fits on existing system nodegroup — $9/month EBS only
  #   5. OpenSearch Dashboards replaced by Grafana + ClickHouse datasource
  #
  # When you WOULD use OpenSearch instead:
  #   - Compliance auditors require a certified SIEM product (SOC2/ISO27001
  #     evidence trail that names a recognised SIEM — OpenSearch/Splunk/QRadar)
  #   - You want pre-built Sigma detection rules without writing Flink CEP jobs
  #   - Security team prefers the OpenSearch Dashboards SIEM UI over Grafana
  #
  # Architecture decision captured in: docs/observability.md
  # ─────────────────────────────────────────────────────────────────────────

  # ── Kafka — event bus for Flink ───────────────────────────────────────────
  # Durable buffer between event sources and Flink.
  # Flink reads from Kafka offsets — restarts cleanly after nightly destroy.
  # Topics: security-gateway-events, opa-decisions,
  #         kubearmor-events, guardduty-events

  - name: kafka
    namespace: observability
    chart: oci://registry-1.docker.io/bitnamicharts/kafka
    needs:
      - kubearmor-system/kubearmor-operator
    values:
      - values/kafka.yaml

  # ── Fluent Bit — KubeArmor log shipping ───────────────────────────────────
  # DaemonSet that reads from KubeArmor relay (gRPC :32767) and ships to:
  #   - Loki  (KubeArmor Runtime dashboard in Grafana)
  #   - Kafka topic kubearmor-events  (for Flink CEP correlation)
  # OpenSearch output removed along with OpenSearch release.

  - name: fluent-bit-kubearmor
    namespace: observability
    chart: fluent/fluent-bit
    needs:
      - observability/kafka
      - kubearmor-system/kubearmor-operator
    values:
      - values/fluent-bit-kubearmor.yaml

  # ── Apache Flink — CEP correlation engine ────────────────────────────────
  # Replaces OpenSearch Security Analytics for all correlation rules.
  # Advantages over OpenSearch:
  #   - Event-time processing with watermarks (handles late-arriving events)
  #   - FlinkCEP: ordered patterns (A then B then C), absence detection
  #   - Stateful interval joins across independent streams
  #   - Stateless between restarts — reads from Kafka offsets, no PVC needed
  # CEP rules: injection→toolcall (60s), probe→inject→exfiltrate (2min),
  #            KubeArmor block ⋈ GuardDuty same node (5min interval join),
  #            Biscuit violations > 3 in 10min

  - name: flink-operator
    namespace: observability
    chart: oci://registry-1.docker.io/apache/flink-kubernetes-operator
    needs:
      - observability/kafka
    values:
      - values/flink-operator.yaml
    hooks:
      - events: ["postsync"]
        command: "bash"
        args: ["{{ env "REPO_ROOT" }}/helmfile/phase3/hooks/flink-deploy-job.sh"]

  # ── ClickHouse — analytics store ──────────────────────────────────────────
  # Replaces OpenSearch as the analytics backend for Grafana dashboards.
  # Advantages over OpenSearch:
  #   - 50x faster aggregation queries (column-oriented storage)
  #   - LowCardinality encoding for fields like decision=allow/deny
  #   - TTL per table — auto-deletes rows older than 1 day (no ISM policy needed)
  #   - Single node fits on existing system nodegroup (30Gi EBS)
  #   - Grafana has official ClickHouse datasource plugin

  - name: clickhouse
    namespace: observability
    chart: oci://registry-1.docker.io/clickhouse/clickhouse
    needs:
      - observability/flink-operator
    values:
      - values/clickhouse.yaml
    hooks:
      - events: ["postsync"]
        command: "bash"
        args: ["{{ env "REPO_ROOT" }}/helmfile/phase3/hooks/clickhouse-init-schema.sh"]
      - events: ["postsync"]
        command: "kubectl"
        args: [apply, -f, "{{ env "REPO_ROOT" }}/helmfile/phase3/manifests/grafana-clickhouse-datasource.yaml"]
      - events: ["postsync"]
        command: "bash"
        args: ["{{ env "REPO_ROOT" }}/helmfile/phase3/hooks/grafana-provision-dashboard.sh"]

  # ── Policy Coverage Gap Analysis CronJob ─────────────────────────────────
  # Runs daily at 06:00. Compares tools/agents in Consul vs OPA/Cedar coverage.
  # Publishes gap report to ClickHouse (was OpenSearch) and SNS.

  - name: gap-analysis
    namespace: infra
    chart: {{ env "REPO_ROOT" }}/charts/gap-analysis
    needs:
      - observability/clickhouse
    values:
      - values/gap-analysis.yaml

  # ── Posture Dashboard + ClickHouse datasource ────────────────────────────
  # Applied as hooks on the clickhouse release (above).
  # GrafanaDatasource CRD wires ClickHouse into Grafana via the operator.
  # grafana-provision-dashboard.sh applies the posture GrafanaDashboard CRD.
