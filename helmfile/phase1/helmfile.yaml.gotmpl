repositories:
  - name: istio
    url: https://istio-release.storage.googleapis.com/charts
  - name: spiffe
    url: https://spiffe.github.io/helm-charts-hardened
  - name: hashicorp
    url: https://helm.releases.hashicorp.com
  - name: opa
    url: https://open-policy-agent.github.io/kube-mgmt/charts
  - name: open-telemetry
    url: https://open-telemetry.github.io/opentelemetry-helm-charts
  - name: grafana
    url: https://grafana.github.io/helm-charts
  - name: ollama
    url: https://otwld.github.io/ollama-helm
  - name: permitio
    url: https://permitio.github.io/opal-helm-chart

helmDefaults:
  wait: true
  timeout: 300
  createNamespace: true

releases:

  # ── Istio ────────────────────────────────────────────────────────────────

  - name: istio-base
    namespace: istio-system
    chart: istio/base
    values:
      - values/istio-base.yaml

  - name: istiod
    namespace: istio-system
    chart: istio/istiod
    needs:
      - istio-system/istio-base
    values:
      - values/istiod.yaml
    hooks:
      - events: ["postsync"]
        command: "kubectl"
        args:
          - apply
          - -f
          - {{ env "REPO_ROOT" }}/helmfile/phase1/manifests/peer-authentication-strict.yaml

  # ── SPIRE ─────────────────────────────────────────────────────────────────

  - name: spire-crds
    namespace: spire-system
    chart: spiffe/spire-crds
    needs:
      - istio-system/istiod

  - name: spire
    namespace: spire-system
    chart: spiffe/spire
    needs:
      - spire-system/spire-crds
    values:
      - values/spire.yaml
    hooks:
      - events: ["postsync"]
        command: "bash"
        args: ["{{ env "REPO_ROOT" }}/helmfile/phase1/hooks/spire-register-entries.sh"]

  # ── Istio Ingress Gateway ────────────────────────────────────────────────

  - name: istio-gateway
    namespace: istio-system
    chart: istio/gateway
    needs:
      - istio-system/istiod
    values:
      - values/istio-gateway.yaml
    hooks:
      - events: ["postsync"]
        command: "kubectl"
        args:
          - apply
          - -f
          - {{ env "REPO_ROOT" }}/helmfile/phase1/manifests/security-gateway-ingress.yaml
      - events: ["postsync"]
        command: "kubectl"
        args:
          - apply
          - -f
          - {{ env "REPO_ROOT" }}/helmfile/phase1/manifests/alb-ingress.yaml

  # ── Consul ────────────────────────────────────────────────────────────────

  - name: consul
    namespace: infra
    chart: hashicorp/consul
    needs:
      - spire-system/spire
    values:
      - values/consul.yaml
    hooks:
      - events: ["postsync"]
        command: "bash"
        args: ["{{ env "REPO_ROOT" }}/helmfile/phase1/hooks/consul-seed-registries.sh"]
      - events: ["postsync"]
        command: "bash"
        args: ["{{ env "REPO_ROOT" }}/helmfile/phase1/hooks/consul-coredns-patch.sh"]

  # ── Vault ─────────────────────────────────────────────────────────────────

  - name: vault
    namespace: infra
    chart: hashicorp/vault
    needs:
      - infra/consul
    values:
      - values/vault.yaml
    hooks:
      - events: ["postsync"]
        command: "bash"
        args: ["{{ env "REPO_ROOT" }}/helmfile/phase1/hooks/vault-init.sh"]

  # ── Keycloak ──────────────────────────────────────────────────────────────

  - name: keycloak
    namespace: infra
    chart: ../../charts/keycloak
    needs:
      - infra/vault
    values:
      - values/keycloak.yaml
    hooks:
      - events: ["postsync"]
        command: "bash"
        args: ["{{ env "REPO_ROOT" }}/helmfile/phase1/hooks/keycloak-configure.sh"]

  # ── OPA ───────────────────────────────────────────────────────────────────

  - name: opa
    namespace: infra
    chart: opa/opa
    needs:
      - infra/consul
    values:
      - values/opa.yaml
    hooks:
      - events: ["postsync"]
        command: "bash"
        args: ["{{ env "REPO_ROOT" }}/helmfile/phase1/hooks/opa-load-policies.sh"]

  # ── Redis (rate limiting) ─────────────────────────────────────────────────

  - name: redis
    namespace: infra
    chart: ../../charts/redis
    values:
      - values/redis.yaml

  # ── Observability ─────────────────────────────────────────────────────────

  - name: otel-collector
    namespace: observability
    chart: open-telemetry/opentelemetry-collector
    values:
      - values/otel-collector.yaml

  - name: loki
    namespace: observability
    chart: grafana/loki-stack
    needs:
      - observability/otel-collector
    values:
      - values/loki.yaml

  - name: grafana
    namespace: observability
    chart: grafana/grafana
    needs:
      - observability/loki
    values:
      - values/grafana.yaml

  # ── Ollama — three isolated CPU inference instances ───────────────────────
  # Scheduled on the inference nodegroup (t3.xlarge, 16 GB).
  # judge:  LLM Judge — validates intent alignment on every tool call
  # policy: Policy LLM — generates and validates Cedar policies
  # embed:  Embedding model — semantic injection detection via arc_pi_taxonomy
  # NOTE: First deploy pulls llama3.1:8b (~4.7 GB) — allow 10–15 min.

  - name: ollama-judge
    namespace: infra
    chart: ollama/ollama
    timeout: 900
    values:
      - values/ollama-judge.yaml
    hooks:
      - events: ["postsync"]
        command: "bash"
        args: ["{{ env "REPO_ROOT" }}/helmfile/phase1/hooks/ollama-wait-models.sh", "ollama-judge", "llama3.1:8b"]

  - name: ollama-policy
    namespace: infra
    chart: ollama/ollama
    timeout: 900
    values:
      - values/ollama-policy.yaml
    hooks:
      - events: ["postsync"]
        command: "bash"
        args: ["{{ env "REPO_ROOT" }}/helmfile/phase1/hooks/ollama-wait-models.sh", "ollama-policy", "llama3.1:8b"]

  - name: ollama-embed
    namespace: infra
    chart: ollama/ollama
    timeout: 900
    values:
      - values/ollama-embed.yaml
    hooks:
      - events: ["postsync"]
        command: "bash"
        args: ["{{ env "REPO_ROOT" }}/helmfile/phase1/hooks/ollama-wait-models.sh", "ollama-embed", "nomic-embed-text"]

  # ── OPAL — real-time policy sync: Consul → OPA ────────────────────────────

  - name: opal
    namespace: infra
    chart: permitio/opal
    needs:
      - infra/consul
      - infra/opa
    values:
      - values/opal.yaml
    hooks:
      - events: ["postsync"]
        command: "bash"
        args: ["{{ env "REPO_ROOT" }}/helmfile/phase1/hooks/opal-verify-sync.sh"]

  # ── Intent-Aware Tool Catalog ─────────────────────────────────────────────

  - name: tool-catalog
    namespace: infra
    chart: ../../charts/tool-catalog
    needs:
      - infra/opal
      - infra/ollama-judge
    values:
      - values/tool-catalog.yaml

  # ── Security Gateway (with Cedar + Biscuit + LLM Guard) ───────────────────

  - name: security-gateway
    namespace: infra
    chart: ../../charts/security-gateway
    needs:
      - infra/tool-catalog
      - infra/ollama-embed
      - infra/opa
      - infra/consul
      - infra/redis
      - spire-system/spire
    values:
      - values/gateway.yaml
      - values/security-gateway-p2.yaml
    hooks:
      - events: ["postsync"]
        command: "bash"
        args: ["{{ env "REPO_ROOT" }}/helmfile/phase1/hooks/biscuit-key-bootstrap.sh"]

  # ── Injection Signal Index ────────────────────────────────────────────────

  - name: injection-signals
    namespace: infra
    chart: ../../charts/injection-signals
    needs:
      - infra/security-gateway
    values:
      - values/injection-signals.yaml
    hooks:
      - events: ["postsync"]
        command: "bash"
        args: ["{{ env "REPO_ROOT" }}/helmfile/phase1/hooks/build-injection-signals.sh"]

  # ── CIBA ACP (with Duo Mobile push) ──────────────────────────────────────

  - name: ciba-acp
    namespace: infra
    chart: ../../charts/ciba-acp
    needs:
      - infra/keycloak
      - infra/security-gateway
    values:
      - values/ciba-acp.yaml
      - values/ciba-acp-p2.yaml
    hooks:
      - events: ["presync"]
        command: "bash"
        args: ["{{ env "REPO_ROOT" }}/helmfile/phase1/hooks/sync-duo-secret.sh"]

  # ── Tool Hash Verifier ────────────────────────────────────────────────────

  - name: hash-verifier
    namespace: infra
    chart: ../../charts/hash-verifier
    needs:
      - infra/opal
    values:
      - values/hash-verifier.yaml

  # ── LiteLLM Proxy ─────────────────────────────────────────────────────────

  - name: litellm
    namespace: infra
    chart: oci://ghcr.io/berriai/litellm-helm
    values:
      - values/litellm.yaml

  # ── Agents ────────────────────────────────────────────────────────────────

  - name: agents
    namespace: agents
    chart: ../../charts/agents
    needs:
      - infra/security-gateway
      - infra/keycloak
      - spire-system/spire
      - observability/otel-collector
    values:
      - values/agents.yaml
